
<idea-plugin>
    <id>com.iishanto</id>
    <name>ApexJetforce</name>
    <vendor>IISHANTO</vendor>
    <description>Apex Jetforce Plugin to support apex class in the dev</description>
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.java</depends>
    <extensions defaultExtensionNs="com.intellij">
            <fileType
                    name="Apex Class"
                    implementationClass="com.iishanto.language.sf.apex.filetypes.ApexClassFileType"
                    fieldName="INSTANCE"
                    language="Apex"
                    extensions="cls"/>
            <fileType
                    name="Apex Trigger"
                    implementationClass="com.iishanto.language.sf.apex.filetypes.ApexTriggerFileType"
                    fieldName="INSTANCE"
                    language="Apex"
                    extensions="trigger"/>
            <lang.parserDefinition
                    language="Apex"
                    implementationClass="com.iishanto.language.sf.parser.ApexClassParserDefinition"/>
            <lang.syntaxHighlighterFactory
                    language="Apex"
                    implementationClass="com.iishanto.language.sf.apex.filetypes.ApexSyntaxHighlighterFactory"/>
            <externalAnnotator
                    language="Apex"
                    implementationClass="com.iishanto.ide.annotator.ApexLanguageExternalAnnotator"/>
        <lang.braceMatcher language="Apex"
                           implementationClass="com.iishanto.ide.codeformatter.ApexPairedBraceMatcher"/>
            <postStartupActivity implementation="com.iishanto.ide.SalesforceProjectStartupActivity"/>
<!--            <highlightErrorFilter implementation="com.iishanto.ide.filters.ErrorFilter"/>-->
            <completion.contributor language="Apex" implementationClass="com.iishanto.ide.autocomplete.ApexLanguageAutoCompletionContributor"/>
            <gotoDeclarationHandler implementation="com.iishanto.ide.gotodeclaration.ApexGotoDeclarationHandler"/>
            <typedHandler implementation="com.iishanto.ide.typedhandler.AutoCompleteTypedHandler"/>
            <moduleType id="SFDX_MODULE" implementationClass="com.iishanto.ide.modulebuilder.SalesforceProjectModuleType"/>
            <moduleBuilder builderClass="com.iishanto.ide.modulebuilder.SalesforceProjectBuilder"/>
            <lang.formatter language="Apex" implementationClass="com.iishanto.ide.codeformatter.ApexLanguageFormattingModelBuilder"/>
            <toolWindow id="Salesforce Output" anchor="bottom" icon="AllIcons.Toolwindows.ToolWindowMessages"
                        factoryClass="com.iishanto.ide.modulebuilder.SalesforceToolWindowFactory"/>
            <toolWindow id="Salesforce" anchor="right"
                        icon="/icons/salesforce.svg"
                        factoryClass="com.iishanto.ide.ui.tabs.SalesforceToolUtility"/>
            <projectService serviceImplementation="com.iishanto.ide.config.SalesforceProjectConfig"/>
        <notificationGroup id="SalesforceToolUtility"
                           displayType="BALLOON"
                           toolWindowId="Event Log"/>
    </extensions>
    <actions>
        <action
                id="com.example.plugin.CreateApexClassAction"
                class="com.iishanto.ide.action.CreateNewApexClassAction"
                text="Apex Class"
                icon="AllIcons.Nodes.Class"
                description="Create a new Apex class">
            <add-to-group group-id="NewGroup" anchor="first"/>
        </action>
    </actions>
    <actions>
        <action id="com.iishanto.plugin.actions.DeployChangedFiles"
                class="com.iishanto.ide.action.DeployChangedFiles"
                text="Deploy current file"
                icon="/icons/deploy.svg"
                description="Deploy current file">
            <add-to-group group-id="RunToolbarMainActionGroup" anchor="first"/>
        </action>
    </actions>

</idea-plugin>