{
  parserClass="com.iishanto.language.sf.grammer.helper.SfApexParser"

  extends="com.intellij.extapi.psi.ASTWrapperPsiElement"

  psiClassPrefix="Simple"
  psiImplClassSuffix="Impl"

  elementTypeClass="com.iishanto.language.sf.grammer.helper.SfApexElementType"
  tokenTypeClass="com.iishanto.language.sf.grammer.helper.SfApexTokenType"

   tokens = [
                  VIRTUAL_KEYWORD = 'virtual'
                  ABSTRACT_KEYWORD = 'abstract'
                  WITH_KEYWORD = 'with'
                  INTERFACE_KEYWORD = 'interface'
                  CLASS_KEYWORD = 'class'
                  SHARING_KEYWORD = 'sharing'
                  WITHOUT_KEYWORD = 'without'
                  INHERITED_KEYWORD = 'inherited'
                  PUBLIC_KEYWORD = 'public'
                  PRIVATE_KEYWORD = 'private'
                  GLOBAL_KEYWORD = 'global'
                  PROTECTED_KEYWORD = 'protected'
                  FINAL_KEYWORD = 'final'
                  STATIC_KEYWORD = 'static'
                  IMPLEMENTES_KEYWORD = 'implements'
                  EXTENDS_KEYWORD = 'extends'
                  GET_METHOD_KEYWORD = 'get'
                  SET_METHOD_KEYWORD = 'set'
                  TRUE_LITERAL = 'true'
                  FALSE_LITERAL = 'false'
                  NEW_KEYWORD = 'new'
                  IF_KEYWORD = 'if'
                    ELSE_KEYWORD = 'else'
                    FOR_KEYWORD = 'for'
                    WHILE_KEYWORD = 'while'
                    DO_KEYWORD = 'do'
                    TRY_KEYWORD = 'try'
                    CATCH_KEYWORD = 'catch'
                    FINALLY_KEYWORD = 'finally'
                    RETURN_KEYWORD = 'return'
                    SWITCH_KEYWORD = 'switch'
                    CASE_KEYWORD = 'case'
                    DEFAULT_KEYWORD = 'default'
                    BREAK_KEYWORD = 'break'
                    CONTINUE_KEYWORD = 'continue'
                    THROW_KEYWORD = 'throw'
                    THIS_KEYWORD = 'this'
                    SUPER_KEYWORD = 'super'
                    ON_KEYWORD = 'on'

                  OVERRIDE_KEYWORD = 'override'
                  WHITE_SPACE = 'regexp:\s+'
                  LBRACE = '{'
                  RBRACE = '}'
                  LPAREN = '('
                  RPAREN = ')'
                  SQURE_LEFT = '['
                    SQURE_RIGHT = ']'
                  COMMA = ','
                  DOT = '.'
                  EQUAL = '=='
                  ASSIGNMENT = '='
                  ANGLE_LEFT = '<'
                  ANGLE_RIGHT = '>'
                  SEMICOLON = ';'
                  AT = '@'
                  NUMBER = 'regexp:[0-9]+(\.?[0-9])*L?'

                  SOQL = 'regexp:SELECT (.*?)(?=])'
                  SOSL = 'regexp:FIND (.*?)(?=])'

                  IDENTIFIER = 'regexp:[a-zA-Z_][a-zA-Z0-9_$]*'
                  STRING  = "regexp:'.*?'"
          ]
}


SfApex ::= ApexClassFile

ApexClassFile ::= ClassAccessModifier ClassModifiers (ClassDeclaration|InterfaceDeclaration)
ClassDeclaration ::= CLASS_KEYWORD TypeDeclaration ClassInheritance ClassBlock
InterfaceDeclaration ::= INTERFACE_KEYWORD TypeDeclaration ClassInheritance InterfaceBlock;
ClassModifiers ::= ClassModifier*
ClassModifier ::= VIRTUAL_KEYWORD | ABSTRACT_KEYWORD | SharingModifier
SharingModifier ::= (WITH_KEYWORD | WITHOUT_KEYWORD | INHERITED_KEYWORD) SHARING_KEYWORD
ClassInheritance ::= (EXTENDS_KEYWORD ImplementsOrExtendClassNameFormat)? ImplementsInterfaceList?

ClassAccessModifier ::= (PUBLIC_KEYWORD|GLOBAL_KEYWORD)
ImplementsInterfaceList ::= IMPLEMENTES_KEYWORD ImplementsOrExtendClassNameFormat (COMMA ImplementsOrExtendClassNameFormat)*
ImplementsOrExtendClassNameFormat ::= IDENTIFIER (DOT IDENTIFIER)?


ClassBlock ::= LBRACE (MemberDeclaration|ApexClassFile)* RBRACE

//TODO: add support for interface
InterfaceBlock ::= LBRACE (MemberDeclaration|ApexClassFile)* RBRACE

/*Field declaration part*/
MemberDeclaration ::= Annotation? MemberAccessModifier? (FINAL_KEYWORD|OVERRIDE_KEYWORD)? STATIC_KEYWORD? TypeDeclaration IDENTIFIER (FieldExtension|MethodParameterExtension)



FieldExtension ::= (MoreCommaSeperatedIds? SEMICOLON|LBRACE GetSetGroup? RBRACE)
MemberAccessModifier ::= (PUBLIC_KEYWORD|PRIVATE_KEYWORD|PROTECTED_KEYWORD|GLOBAL_KEYWORD)

TypeDeclaration ::= IDENTIFIER (DOT IDENTIFIER)? (ANGLE_LEFT TypeDeclaration (COMMA TypeDeclaration)? ANGLE_RIGHT)?

MoreCommaSeperatedIds ::= ((ASSIGNMENT RhsExpression)) | (COMMA IDENTIFIER (ASSIGNMENT RhsExpression)?)+

GetSetGroup ::= GetMethod SEMICOLON SetMethod SEMICOLON| SetMethod SEMICOLON GetMethod SEMICOLON | GetMethod SEMICOLON |SetMethod SEMICOLON
GetMethod ::= GET_METHOD_KEYWORD
SetMethod ::= SET_METHOD_KEYWORD

RhsExpression ::=  BaseExpression LogicalExpression?

BaseExpression ::= PrimitiveType | ValueRetrievingExpression | DatabaseExpression
DatabaseExpression ::= SQURE_LEFT (SOQL | SOSL) SQURE_RIGHT

PrimitiveType ::= NUMBER | STRING | TRUE_LITERAL | FALSE_LITERAL

CollectionInitializer ::= LBRACE CollectionInitializerItem RBRACE
CollectionInitializerItem ::= (RhsExpression (ASSIGNMENT ANGLE_RIGHT RhsExpression) ?) (COMMA RhsExpression (ASSIGNMENT ANGLE_RIGHT RhsExpression) ?)*

ValueRetrievingExpression ::= MethodCallOrVariable | NewClassExpression (DOT ValueRetrievingExpression)?

NewClassExpression ::= NEW_KEYWORD TypeDeclaration (ArgumentList|CollectionInitializer);

MethodCallOrVariable ::= IDENTIFIER (DOT IDENTIFIER)? ArgumentList?

ArgumentList ::= LPAREN (CommaSeperatedExpressions)? RPAREN
CommaSeperatedExpressions ::=(RhsExpression SObjectInitializationUnit? (COMMA RhsExpression SObjectInitializationUnit?)*)
SObjectInitializationUnit ::= ASSIGNMENT RhsExpression

Annotation ::= AT MethodCallOrVariable
MethodParameterExtension ::= LPAREN ParameterList RPAREN MethodBlock

ParameterList ::= (ParameterUnit (COMMA ParameterUnit)*)?
ParameterUnit ::= IDENTIFIER IDENTIFIER

MethodBlock ::= LBRACE LocalContents* RBRACE

LocalContents ::= LocalVariableDeclaration | LocalVariableORMethodCall | IfStatement | TryCatchBlock | SwitchStatement | ReturnStatement;
ReturnStatement ::= RETURN_KEYWORD RhsExpression SEMICOLON

LocalVariableDeclaration ::= TypeDeclaration IDENTIFIER (MoreCommaSeperatedIds)? SEMICOLON
LocalVariableORMethodCall ::= RhsExpression (SEMICOLON|LocalVariableRightSide)
LocalVariableRightSide ::= ASSIGNMENT RhsExpression SEMICOLON

IfStatement ::= IF_KEYWORD LPAREN RhsExpression RPAREN LBRACE LocalContents* RBRACE (ELSE_KEYWORD IfStatement)* (ELSE_KEYWORD LBRACE LocalContents* RBRACE)?
TryCatchBlock ::= TRY_KEYWORD LBRACE LocalContents* RBRACE CatchBlock* FinallyBlock*
CatchBlock ::= CATCH_KEYWORD LPAREN TypeDeclaration IDENTIFIER RPAREN LBRACE LocalContents* RBRACE
FinallyBlock ::= FINALLY_KEYWORD LBRACE LocalContents* RBRACE


SwitchStatement ::= SWITCH_KEYWORD ON_KEYWORD SwitchType SwitchBlock
SwitchBlock ::= LBRACE SwitchBody RBRACE
SwitchBody ::= (SwitchWhenBlock)*

SwitchWhenBlock ::= when (IDENTIFIER? ValueList | ELSE_KEYWORD) LBRACE LocalContents* RBRACE

ValueList ::= RhsExpression (COMMA RhsExpression)*

SwitchType ::= STRING | NUMBER | IDENTIFIER

/* All type of primary expressions */
//logical
LogicalExpression ::= EQUAL RhsExpression